# Copy to .env.local — or just run `npm run setup`, which fills this in for you.

# Local development uses a SQLite file. In production point this at a Turso
# database (libsql://your-db.turso.io) and set DATABASE_AUTH_TOKEN.
DATABASE_URL="file:./data/app.db"
DATABASE_AUTH_TOKEN=""

# Random string, 32+ characters. Signs the administrator session cookie.
SESSION_SECRET=""

# The single administrator account. ADMIN_PASSWORD_HASH is a bcrypt hash —
# generate one with `npm run setup`, never store the plain password here.
#
# In a .env file every $ in the hash must be escaped as \$, because Next.js
# expands $NAME references. On a hosting dashboard (Vercel etc.) paste the hash
# exactly as generated, with no escaping.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH=""

# Country code pre-selected in the student application form (60 = Malaysia).
NEXT_PUBLIC_DEFAULT_COUNTRY_CODE="60"
